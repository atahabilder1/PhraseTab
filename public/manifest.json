{
  "manifest_version": 3,
  "name": "PhraseTab",
  "version": "0.1.0",
  "description": "Learn a useful English word or phrase with every new tab. Offline, private, no account.",
  "minimum_chrome_version": "108",
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_page": "settings.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
